# Copy to .env and fill in. Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(24))"
PT_ADMIN_TOKEN=change-me
# Optional club-wide sign-up code that works unlimited times. Leave empty to use only single-use codes (admin > Codes).
PT_INVITE_CODE=
PT_STARTING_CASH=100000
PT_PRICE_PROVIDER=yfinance
PT_QUOTE_TTL_SECONDS=15
PT_SLIPPAGE_BPS=5
PT_COMMISSION_PER_ORDER=0
PT_SNAPSHOT_SECONDS=60
# 1 = timed snapshots only during US market hours (orders always snapshot). Set 0 for crypto or 24h strategies.
PT_SNAPSHOT_MARKET_HOURS_ONLY=1
# Shorting: 0 turns it off. Margin is extra cash held on top of short proceeds, as a fraction of short value.
PT_ALLOW_SHORTING=1
PT_SHORT_MARGIN=0.5
PT_SHORT_MAINT_MARGIN=0.3
# Off by default. 1 = the minute check force-covers shorts below the maintenance level (down to free cash 0)
PT_AUTO_LIQUIDATE=0
# Long-only option contracts (buy to open, sell to close, cash-settled at expiry). 0 turns them off
PT_ALLOW_OPTIONS=1
# Limit orders: how many can rest at once per account, and how many days before they expire (0 = never)
PT_MAX_OPEN_LIMITS=50
# Extra personal portfolios each member may create (competition portfolios do not count)
PT_MAX_PORTFOLIOS=10
PT_LIMIT_EXPIRY_DAYS=30
# Splits and dividends: how often to ask the data feed, in seconds (0 = never, admin enters them by hand)
PT_ACTIONS_CHECK_SECONDS=3600
